# ==========================================
# Addis Eats - Environment Configuration
# ==========================================
# Duplicate this file as '.env.local' for local development.
# Do NOT store real production secrets in this template.

# Base Application Host URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base API Endpoint URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Third-Party Analytics Tracking ID (Google Analytics / Google Tag Manager)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Session & Auth Cookie Encryption Secret (minimum 32 characters for security)
SESSION_SECRET=super_secret_session_encryption_key_at_least_32_chars

# Application Environment Mode (development | production | test)
NODE_ENV=development
